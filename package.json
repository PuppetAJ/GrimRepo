{
  "name": "grimrepo",
  "version": "2.0.0",
  "private": true,
  "description": "Grim Repo - an Inscryption-style card game on a three.js table. React Three Fiber client, Express API, Postgres.",
  "author": "Adrian Jimenez",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PuppetAJ/GrimRepo.git"
  },
  "bugs": {
    "url": "https://github.com/PuppetAJ/GrimRepo/issues"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --stream dev",
    "dev:client": "pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --recursive build",
    "start": "pnpm --filter server start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "test:e2e": "node --env-file-if-exists=.env e2e/run.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:seed": "pnpm --filter server db:seed",
    "db:seed:empty": "pnpm --filter server db:seed:empty"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "plugins": [
      "prettier-plugin-organize-imports",
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./client/src/index.css",
    "tailwindFunctions": [
      "cn",
      "cva"
    ]
  },
  "devDependencies": {
    "oxlint": "^1.85.0",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "railway": "^3.11.0"
  }
}
