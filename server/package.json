{
  "name": "server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Grim Repo API",
  "license": "MIT",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.ts",
    "start": "node --env-file-if-exists=../.env src/server.ts",
    "db:migrate": "node --env-file-if-exists=../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "db:migrate:down": "node --env-file-if-exists=../.env node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations",
    "db:seed": "node --env-file-if-exists=../.env src/scripts/seed.ts",
    "db:seed:empty": "node --env-file-if-exists=../.env src/scripts/seed.ts --if-empty",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=../.env --import ./src/test/env.ts src/scripts/setup-test-db.ts && node --env-file-if-exists=../.env --import ./src/test/env.ts --test --test-concurrency=1 'src/**/*.test.ts'"
  },
  "dependencies": {
    "better-auth": "^1.7.5",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^7.0.2"
  }
}
