# The docker-compose Postgres service.
DATABASE_URL=postgresql://grimrepo:grimrepo@127.0.0.1:5433/grimrepo

# Any free port for the API; the client's dev server proxies to it.
PORT=3001

# The address you open in the browser.
APP_URL=http://localhost:3000

# Generated with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output

# The same Postgres service, with a database name that ends in _test.
TEST_DATABASE_URL=postgresql://grimrepo:grimrepo@127.0.0.1:5433/grimrepo_test
