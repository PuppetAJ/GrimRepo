# Copy to .env and fill in. Blank keys are filled in as their phase arrives.

# Matches the docker-compose service.
DATABASE_URL=postgresql://grimrepo:grimrepo@127.0.0.1:5433/grimrepo

# Port the API listens on; the Vite dev server proxies /api and /health to it.
PORT=3001

# The origin the browser sees. Better Auth checks requests against it and scopes cookies to it.
APP_URL=http://localhost:3000

# `openssl rand -base64 32`. Local only; Railway has its own.
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32-output

# Created and migrated by `pnpm test`, and wiped between tests. Must end in _test.
TEST_DATABASE_URL=postgresql://grimrepo:grimrepo@127.0.0.1:5433/grimrepo_test
