{
  "compilerOptions": {
    // Vite compiles the code, so TypeScript only checks.
    "noEmit": true,

    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension included, the same way the server's do.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    // shadcn/ui's generated components import each other as "@/components/…"; vite.config.ts repeats this.
    "paths": {
      "@/*": ["./src/*"]
    },

    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src", "vite.config.ts"]
}
